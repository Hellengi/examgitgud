{
  "info": {
    "name": "ExamGitGud API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Вход с верными данными",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"anna@example.com\", \"password\": \"Anna2026!\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 200', () => pm.response.to.have.status(200));",
              "pm.test('Роль STUDENT', () => pm.expect(pm.response.json().role).to.eql('STUDENT'));",
              "pm.collectionVariables.set('userId', pm.response.json().id);",
              "pm.test('Ответ быстрее 500 мс', () => pm.expect(pm.response.responseTime).to.be.below(500));"
            ]
          }
        }
      ]
    },
    {
      "name": "Вход с неверным паролем",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"anna@example.com\", \"password\": \"qwerty\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 401', () => pm.response.to.have.status(401));",
              "pm.test('Сообщение об ошибке', () => pm.expect(pm.response.json().error).to.eql('Ошибка аутентификации'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Список заданий по теме",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/tasks?topicId=2",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tasks"
          ],
          "query": [
            {
              "key": "topicId",
              "value": "2"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 200', () => pm.response.to.have.status(200));",
              "pm.test('Только тема 2', () => pm.response.json().forEach(t => pm.expect(t.topicId).to.eql(2)));",
              "pm.test('Эталон не передаётся', () => pm.response.json().forEach(t => pm.expect(t).to.not.have.property('correctAnswer')));"
            ]
          }
        }
      ]
    },
    {
      "name": "Проверка ответа с запятой",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/tasks/3/check",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tasks",
            "3",
            "check"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"answer\": \"0.5\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Ответ засчитан', () => pm.expect(pm.response.json().correct).to.be.true);",
              "pm.test('Есть разбор', () => pm.expect(pm.response.json().solution).to.not.be.empty);"
            ]
          }
        }
      ]
    },
    {
      "name": "Старт пробного экзамена",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/attempts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "attempts"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"userId\": 1, \"examId\": 1}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 200', () => pm.response.to.have.status(200));",
              "const a = pm.response.json();",
              "pm.collectionVariables.set('attemptId', a.id);",
              "pm.test('Попытка идёт', () => pm.expect(a.status).to.eql('IN_PROGRESS'));",
              "pm.test('Есть время окончания', () => pm.expect(a.deadline).to.be.a('string'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Сохранение ответа",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/attempts/{{attemptId}}/answers/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "attempts",
            "{{attemptId}}",
            "answers",
            "1"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"answer\": \"4\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Завершение экзамена",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/attempts/{{attemptId}}/finish",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "attempts",
            "{{attemptId}}",
            "finish"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус FINISHED', () => pm.expect(pm.response.json().status).to.eql('FINISHED'));",
              "pm.test('1 балл', () => pm.expect(pm.response.json().score).to.eql(1));"
            ]
          }
        }
      ]
    },
    {
      "name": "Повторное завершение запрещено",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/attempts/{{attemptId}}/finish",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "attempts",
            "{{attemptId}}",
            "finish"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 409', () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "attemptId",
      "value": ""
    }
  ]
}